
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bitcoinminersco | Plataforma Oficial</title>
    <style>
        :root {
            --primary: #f2a900;
            --dark: #0f0f12;
            --surface: #1a1a24;
            --text: #ffffff;
            --text-muted: #a0a0b0;
            --safe-green: #00ff88;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background-color: var(--dark); color: var(--text); overflow-x: hidden; }
        
        /* Navbar */
        header { background: var(--surface); padding: 1rem 5%; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--primary); position: sticky; top: 0; z-index: 100; }
        .logo { font-size: 1.4rem; font-weight: 800; color: var(--primary); letter-spacing: 1px; }
        nav a, .admin-trigger { color: var(--text); text-decoration: none; margin-left: 1.5rem; font-size: 0.95rem; cursor: pointer; transition: color 0.3s; }
        nav a:hover, .admin-trigger:hover { color: var(--primary); }

        /* Hero */
        .hero { padding: 6rem 5%; text-align: center; background: radial-gradient(circle at center, #241a00 0%, var(--dark) 70%); }
        .hero h1 { font-size: 3.2rem; margin-bottom: 1.5rem; font-weight: 800; }
        .hero h1 span { color: var(--primary); }
        .hero p { font-size: 1.2rem; color: var(--text-muted); max-width: 700px; margin: 0 auto 2.5rem; }

        /* Grid de Contenido */
        .content-section { padding: 5rem 5%; background: var(--surface); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 3rem; }
        .card { background: var(--dark); padding: 2.5rem 2rem; border-radius: 12px; border: 1px solid #2a2a3a; transition: transform 0.3s, border-color 0.3s; }
        .card:hover { transform: translateY(-5px); border-color: var(--primary); }
        .card h3 { color: var(--primary); margin-bottom: 1rem; font-size: 1.3rem; }
        .card p { color: var(--text-muted); font-size: 0.95rem; }

        /* Panel de Administración Oculto Securizado */
        #adminPanel { display: none; position: fixed; top: 0; right: 0; width: 400px; height: 100vh; background: #111118; box-shadow: -5px 0 25px rgba(0,0,0,0.8); z-index: 1000; padding: 2rem; overflow-y: auto; border-left: 3px solid var(--primary); }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #222; }
        .close-admin { background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer; }
        .form-group { margin-bottom: 1.5rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; color: var(--primary); font-size: 0.85rem; text-transform: uppercase; }
        .form-group input, .form-group textarea { width: 100%; padding: 0.75rem; background: var(--surface); border: 1px solid #333; color: white; border-radius: 6px; }
        .btn-action { width: 100%; padding: 0.8rem; background: var(--primary); border: none; font-weight: bold; border-radius: 6px; cursor: pointer; margin-top: 1rem; }
        .btn-action:hover { background: #d49400; }
        .logout-btn { background: #ff3333; color: white; margin-top: 2rem; }
        
        /* Modal de Login */
        #loginModal { display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); z-index: 2000; justify-content: center; align-items: center; }
        .login-box { background: var(--surface); padding: 3rem; border-radius: 12px; width: 100%; max-width: 400px; border: 1px solid var(--primary); text-align: center; }

        footer { background: var(--dark); padding: 3rem 5%; text-align: center; color: var(--text-muted); border-top: 1px solid #222; font-size: 0.9rem; }
    </style>
</head>
<body>

    <!-- Encabezado / Navegación -->
    <header>
        <div class="logo">Bitcoinminersco</div>
        <nav>
            <a href="#inicio">Inicio</a>
            <a href="#servicios">Servicios</a>
            <span class="admin-trigger" onclick="openAdminFlow()">⚙️ Administrar</span>
        </nav>
    </header>

    <!-- Sección de Bienvenida (Editable) -->
    <section class="hero" id="inicio">
        <h1 id="view-hero-title">Minería de Bitcoin de <span>Próxima Generación</span></h1>
        <p id="view-hero-desc">Optimiza tus operaciones de minería con infraestructura de alta eficiencia, energía sostenible y el mejor hardware criptográfico del mercado.</p>
    </section>

    <!-- Sección de Servicios (Editable) -->
    <section class="content-section" id="servicios">
        <div class="grid">
            <div class="card">
                <h3 id="view-card1-title">Venta de Hardware</h3>
                <p id="view-card1-desc">Distribuimos los mineros ASIC más eficientes y potentes del mercado directamente con los creadores mundiales.</p>
            </div>
            <div class="card">
                <h3 id="view-card2-title">Hospedaje de Equipos</h3>
                <p id="view-card2-desc">Aloja tus plataformas en nuestros centros de datos dedicados con sistemas de refrigeración industrial avanzada.</p>
            </div>
            <div class="card">
                <h3 id="view-card3-title">Energía Eco-Eficiente</h3>
                <p id="view-card3-desc">Operamos exclusivamente con fuentes de energía renovable reduciendo los costos operativos del procesamiento de bloques.</p>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Bitcoinminersco. Plataforma web protegida localmente.</p>
    </footer>

    <!-- MODAL DE AUTENTICACIÓN SEGURA -->
    <div id="loginModal">
        <div class="login-box">
            <h2 style="margin-bottom: 1.5rem; color: var(--primary);">Acceso de Administrador</h2>
            <div class="form-group" style="text-align: left;">
                <label>Contraseña Maestra</label>
                <input type="password" id="adminPassword" placeholder="Introduce la contraseña clave">
            </div>
            <button class="btn-action" onclick="verifyAdminPassword()">Ingresar al Sistema</button>
            <button class="btn-action" style="background:#444; color:white;" onclick="closeLoginModal()">Cancelar</button>
        </div>
    </div>

    <!-- PANEL LATERAL CMS (CONTROL DE CAMBIOS) -->
    <div id="adminPanel">
        <div class="admin-header">
            <h3>Panel de Control</h3>
            <button class="close-admin" onclick="closeAdminPanel()">×</button>
        </div>
        
        <h4 style="color:var(--safe-green); margin-bottom:1rem;">📝 Modificar Textos de la Web</h4>
        
        <div class="form-group">
            <label>Título Principal (Hero)</label>
            <input type="text" id="input-hero-title">
        </div>
        <div class="form-group">
            <label>Descripción Principal</label>
            <textarea id="input-hero-desc" rows="3"></textarea>
        </div>
        
        <hr style="border-color:#222; margin:1.5rem 0;">

        <div class="form-group">
            <label>Tarjeta 1: Título</label>
            <input type="text" id="input-card1-title">
        </div>
        <div class="form-group">
            <label>Tarjeta 1: Descripción</label>
            <textarea id="input-card1-desc" rows="2"></textarea>
        </div>

        <div class="form-group">
            <label>Tarjeta 2: Título</label>
            <input type="text" id="input-card2-title">
        </div>
        <div class="form-group">
            <label>Tarjeta 2: Descripción</label>
            <textarea id="input-card2-desc" rows="2"></textarea>
        </div>

        <div class="form-group">
            <label>Tarjeta 3: Título</label>
            <input type="text" id="input-card3-title">
        </div>
        <div class="form-group">
            <label>Tarjeta 3: Descripción</label>
            <textarea id="input-card3-desc" rows="2"></textarea>
        </div>

        <button class="btn-action" onclick="saveWebChanges()">💾 Aplicar y Publicar Cambios</button>
        <button class="btn-action logout-btn" onclick="adminLogout()">Cerrar Sesión Segura</button>
    </div>

    <!-- LÓGICA DE PROGRAMACIÓN Y SEGURIDAD -->
    <script>
        // CONTRASEÑA POR DEFECTO CIFRADA (Para cambiarla, puedes modificar este script)
        // La contraseña por defecto instalada aquí es: "admin123"
        const SECRET_HASH = "8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918"; 

        // Algoritmo de encriptación SHA-256 para validación segura en cliente
        async function sha256(message) {
            const msgBuffer = new TextEncoder().encode(message);                    
            const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        }

        // Cargar los datos guardados por el administrador de inmediato al abrir la página
        window.onload = function() {
            loadWebsiteData();
        };

        function loadWebsiteData() {
            const fields = ['hero-title', 'hero-desc', 'card1-title', 'card1-desc', 'card2-title', 'card2-desc', 'card3-title', 'card3-desc'];
            fields.forEach(field => {
                const savedValue = localStorage.getItem('btcminers-' + field);
                if(savedValue) {
                    document.getElementById('view-' + field).innerHTML = savedValue;
                }
            });
        }

        function openAdminFlow() {
            if (sessionStorage.getItem('isBtcAdmin') === 'true') {
                showAdminPanel();
            } else {
                document.getElementById('loginModal').style.display = 'flex';
            }
        }

        function closeLoginModal() {
            document.getElementById('loginModal').style.display = 'none';
            document.getElementById('adminPassword').value = '';
        }

        async function verifyAdminPassword() {
            const inputPass = document.getElementById('adminPassword').value;
            const hashedInput = await sha256(inputPass);

            if(hashedInput === SECRET_HASH) {
                sessionStorage.setItem('isBtcAdmin', 'true');
                closeLoginModal();
                showAdminPanel();
            } else {
                alert('Acceso Denegado: Credencial incorrecta.');
                closeLoginModal();
            }
        }

        function showAdminPanel() {
            document.getElementById('adminPanel').style.display = 'block';
            
            // Rellenar campos del panel con lo que hay actualmente en pantalla
            const fields = ['hero-title', 'hero-desc', 'card1-title', 'card1-desc', 'card2-title', 'card2-desc', 'card3-title', 'card3-desc'];
            fields.forEach(field => {
                document.getElementById('input-' + field).value = document.getElementById('view-' + field).innerText;
            });
        }

        function closeAdminPanel() {
            document.getElementById('adminPanel').style.display = 'none';
        }

        function saveWebChanges() {
            if (sessionStorage.getItem('isBtcAdmin') !== 'true') return;

            const fields = ['hero-title', 'hero-desc', 'card1-title', 'card1-desc', 'card2-title', 'card2-desc', 'card3-title', 'card3-desc'];
            
            fields.forEach(field => {
                const newValue = document.getElementById('input-' + field).value;
                localStorage.setItem('btcminers-' + field, newValue);
            });

            loadWebsiteData(); // Refrescar los textos visibles
            alert('¡Cambios guardados con éxito de manera segura!');
            closeAdminPanel();
        }

        function adminLogout() {
            sessionStorage.removeItem('isBtcAdmin');
            closeAdminPanel();
            alert('Sesión de administración cerrada.');
        }
    </script>
</body>
</html>
